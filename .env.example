# Copia este archivo como ".env" (sin el .example) y coloca tus datos reales.
# El archivo .env NUNCA debe subirse a git (agrégalo a .gitignore).

DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=TT
# "disable" si Postgres corre en tu propia maquina (localhost).
# "require" si usas Neon u otro Postgres en la nube.
DB_SSLMODE=disable
# Mensajes de error en ingles (evita el error de encoding). Dejar asi para
# Postgres local; para Neon debe quedar VACIO (ver ejemplo abajo).
DB_PG_OPTIONS=-c lc_messages=C

# --- Ejemplo de configuracion para Neon (descomenta y reemplaza los valores) ---
# DB_USER=tu_usuario_de_neon
# DB_PASSWORD=tu_password_de_neon
# DB_HOST=ep-xxxxx.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_SSLMODE=require
# DB_PG_OPTIONS=